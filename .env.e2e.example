# Copy to .env.e2e (gitignored) or point E2E_ENV_FILE at a file OUTSIDE the repo.
# Placeholders only - never commit real values. See e2e/README.md.

# App under test: a running PRODUCTION build, loopback only. Default shown.
E2E_BASE_URL=http://localhost:3101

# The database that app writes to. Host MUST be loopback and the NAME MUST end
# in _e2e - the suite refuses to start otherwise (resetCounts() deletes counts).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/truestock_e2e

# One account per role, seeded into that database (bun run create-user).
# A role with no credentials is skipped with a loud "NOT VERIFIED" line.
E2E_OWNER_EMAIL=owner@example.test
E2E_OWNER_PASSWORD=
E2E_MANAGER_EMAIL=manager@example.test
E2E_MANAGER_PASSWORD=
E2E_STAFF_EMAIL=staff@example.test
E2E_STAFF_PASSWORD=

# Read by the app container that scripts/e2e-rig.sh starts (not by Playwright).
# BETTER_AUTH_URL is overridden per port by the rig; the other two are yours.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3101
# Absolute path. Bind-mounted at the SAME path in the container; a mismatch fails
# as phantom 404s on invoice files.
INVOICE_STORAGE_DIR=

# Optional: drive the locally installed Chrome instead of bundled Chromium.
# E2E_CHANNEL=chrome
