{
  "name": "truestock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/run-tests.sh",
    "check:migrations-immutable": "bash scripts/check-migrations-immutable.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "create-user": "tsx scripts/create-user.ts",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:shell": "docker compose exec app bash",
    "docker:migrate": "docker compose exec -T app bun run db:migrate",
    "docker:seed": "docker compose exec -T app bun run db:seed",
    "docker:reset": "docker compose down -v && docker compose up -d --wait && docker compose exec -T app bun run db:migrate && docker compose exec -T app bun run db:seed",
    "db:shell": "docker compose exec db mariadb -utruestock -ptruestock truestock",
    "db:logs": "docker compose logs -f db",
    "test:docker": "docker compose exec -T -e DATABASE_URL=mysql://truestock:truestock@db:3306/truestock_test app bun test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "barcode-detector": "^3.2.1",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "mysql2": "^3.23.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
