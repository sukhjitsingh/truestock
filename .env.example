# Copy to .env.local for development. Never commit a filled-in copy.

# MySQL — Hostinger hPanel creates these. Pool size is set in code (5–10), not here.
DATABASE_URL="mysql://user:password@localhost:3306/handlebar"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
