# Copy to .env.local for development. Never commit a filled-in copy.

# MySQL — Hostinger hPanel creates these. Pool size is set in code (5–10), not here.
DATABASE_URL="mysql://user:password@localhost:3306/truestock"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Phase 2.5: invoice automation ---

# Where invoice originals are stored. MUST resolve OUTSIDE the Next.js web root
# — never inside public/, and deployment must not symlink it into public/.
# Next serves public/ statically ahead of the application, so a file placed
# there is retrievable with no session, no role check and no organization
# predicate: a supplier invoice carrying negotiated pricing, readable from a
# browser with no account. The only read path is the authenticated, ownership-
# checked, traversal-guarded GET /api/invoices/[id]/file handler.
# Development may use this relative path. Production MUST use an absolute,
# persistent directory outside the replaceable deployment/release tree, for
# example /home/<account>/truestock-data/invoices. Audit ZIPs live under the
# same root, so the directory and database must be backed up/restored together.
INVOICE_STORAGE_DIR="./var/invoices"

# Claude Vision — the extraction pipeline's OCR path for scanned/mixed PDFs
# (lib/domain/extraction-pipeline.ts:extractInvoice). Get one at
# https://console.anthropic.com/settings/keys. If unset at runtime, extraction
# fails the claimed job gracefully (extraction_job -> failed, a clear
# errorMessage) rather than throwing uncaught or crashing the cron interval —
# never write a real key here, this file is committed.
ANTHROPIC_API_KEY=""

# Audit-packet completion email. Leave EMAIL_PROVIDER unset in development to
# use the logged/testable dev outbox. Production currently supports SendGrid's
# v3 mail/send endpoint through a direct fetch call.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
